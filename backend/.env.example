PORT=5000
# Paste your Neon connection string here (or local Postgres URL for dev)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173

# Need cover images (multipart): either ImageKit (recommended) or local disk fallback.
#
# ImageKit — set all three to upload from the server after Multer; DB stores the returned https URL.
# Keys: ImageKit dashboard → Developer → API Keys. URL endpoint: e.g. https://ik.imagekit.io/your_imagekit_id/
IMAGEKIT_PUBLIC_KEY=public_gRmhZ9MyeLHekHisQRzXQE+Fbg8=
IMAGEKIT_PRIVATE_KEY=private_nFE/KtnBr2EmJt46QswRyG1DrQU=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/hasnat/
# Optional Media Library folder (no leading/trailing slashes). Default: equivalence-engine/needs
IMAGEKIT_FOLDER=Micathon
#
# If ImageKit vars are omitted, files go to backend/uploads/ (gitignored). Express serves GET /uploads/...
# In production behind a separate SPA host, proxy /uploads to the API if you use local storage.

